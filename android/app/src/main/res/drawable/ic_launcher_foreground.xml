<?xml version="1.0" encoding="utf-8"?>
<!--
  The reactor ring, as a vector. Same idea as the on-screen one and drawn for
  the same reason: it scales to every launcher density without a single PNG,
  and it recolours by editing one hex value.

  Adaptive icons put the foreground on a 108x108 canvas of which only the
  middle 72x72 is guaranteed visible, so everything here stays well inside
  the safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer rail -->
    <path
        android:strokeColor="#35E0F0"
        android:strokeWidth="2"
        android:strokeAlpha="0.55"
        android:pathData="M54,26 A28,28 0 1,1 53.9,26" />

    <!-- The state arc, the one asymmetric element -->
    <path
        android:strokeColor="#35E0F0"
        android:strokeWidth="4"
        android:pathData="M54,30 A24,24 0 0,1 78,54" />

    <!-- Inner ring -->
    <path
        android:strokeColor="#35E0F0"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.85"
        android:pathData="M54,41 A13,13 0 1,1 53.9,41" />

    <!-- Core -->
    <path
        android:fillColor="#35E0F0"
        android:fillAlpha="0.9"
        android:pathData="M54,48 A6,6 0 1,1 53.9,48 Z" />
</vector>
