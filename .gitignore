# Your settings. config.example.toml is the one that's tracked -- your copy
# holds real contact names.
config.toml

# Model weights and voices. Multi-gigabyte; fetched by scripts/install.sh.
models/
voices/
bin/
*.gguf
*.bin
*.onnx

# Build trees. scripts/postbuild.sh deletes these on the phone anyway.
.build/

# Runtime state
.nisos/
*.log
*.wav

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# The signing key, restored from the NISOS_KEYSTORE_B64 repository secret at
# build time -- see .github/workflows/android-app.yml. Ignored rather than merely
# absent: committing it would let anyone build an APK that Android accepts as a
# silent update to a real install.
android/nisos.jks
*.jks
*.keystore

# Android build output. `.gradle/` is a cache and `build/` is generated; the
# APK you want is a release asset, not something committed.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
